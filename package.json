{
  "name": "eleventy-nunjucks-template",
  "version": "1.0.1",
  "description": "my website",
  "main": "index.html",
  "scripts": {
    "init": "robi init",
    "release": "robi release",
    "status": "robi status",
    "version": "robi version",
    "verbose": "robi verbose",
    "test": "jest --env=jsdom --coverage --runInBand --verbose",
    "task": "tsx src/setup/scripts/task.ts",
    "app": "tsx src/setup/scripts/app.ts",
    "health": "npm run task health",
    "dev": "npm run task dev",
    "build": "NODE_ENV=production tsx src/setup/scripts/build.ts",
    "start:healthcheck_wait": "until curl -sf -o /dev/null http://localhost:3000/@vite/client; do sleep 0.2; done; npm run build:healthcheck_fast; wait",
    "build:healthcheck": "npm run build_appX -- healthcheck",
    "build:healthcheck_fast": "npm run build_appX -- healthcheck --fast",
    "start:api": "tsx watch --clear-screen=false src/backend/apps/api/index.ts",
    "watch:api": "chokidar 'src/frontend' -c 'npm run build:api'",
    "watch:healthcheck": "chokidar 'src/frontend' -c 'npm run build:healthcheck_fast'",
    "build:api": "npm run build_appX -- api",
    "build_appX": "sh -c 'tsx src/backend/apps/$1/index.ts $2' --",
    "start_app": "sh -c 'tsx watch --clear-screen=false src/backend/apps/$1/index.ts' --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willi84/XXX-XXX.git"
  },
  "keywords": [
    "website",
    "personal",
    "profile"
  ],
  "author": "Robert Willemelis",
  "license": "SEE LICENSE in LICENSE.md",
  "bugs": {
    "url": "https://github.com/willi84/XXX-XXX/issues"
  },
  "homepage": "https://github.com/willi84/XXX-XXX#readme",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.0",
    "@robert.tools/cmd": "^1.0.0",
    "@robert.tools/fs": "^1.3.0",
    "@robert.tools/http": "^2.0.1",
    "@robert.tools/log": "^1.0.0",
    "@robert.tools/setup": "^1.3.0",
    "@types/jest": "^29.5.3",
    "@types/markdown-it": "^14.2.0",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "jiti": "^2.7.0",
    "mock-fs": "^5.5.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^4.9.5",
    "vite": "^2.9.18"
  },
  "dependencies": {
    "@robert.tools/eleventy-filter-all-values": "^1.0.0",
    "@robert.tools/eleventy-filter-by-prop": "^1.0.0",
    "@robert.tools/eleventy-filter-contains": "^1.0.0",
    "@robert.tools/eleventy-filter-get-full-date": "^1.0.0",
    "@robert.tools/eleventy-filter-get-search-value": "^1.0.0",
    "@robert.tools/eleventy-filter-is-link": "^1.0.0",
    "@robert.tools/eleventy-filter-len": "^1.0.0",
    "@robert.tools/eleventy-filter-merge": "^1.0.0",
    "@robert.tools/eleventy-filter-pretty-date": "^1.1.0",
    "@robert.tools/eleventy-filter-route": "^1.0.0",
    "@robert.tools/eleventy-filter-safe-param": "^1.0.1",
    "@robert.tools/eleventy-filter-safe-param-if": "^1.0.0",
    "@robert.tools/eleventy-filter-svg": "^1.0.1",
    "@robert.tools/eleventy-filter-translate": "^1.0.0",
    "@robert.tools/eleventy-shortcodes-script-style": "^1.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "markdown-it": "12.3.2"
  }
}
